# 이 파일을 복사해서 같은 폴더에 .env.local 을 만들고 = 뒤에 값을 붙여 넣으세요.
# .env.local 은 GitHub에 올라가지 않아요. 이 예시 파일에는 값을 절대 넣지 마세요.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 절대 공개 금지 (관제 웹 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Developers → 내 애플리케이션 → 앱 키
NEXT_PUBLIC_KAKAO_JS_KEY=
# 절대 공개 금지 (관제 웹 서버에서만 사용)
KAKAO_REST_KEY=

# 개발용 테스트 계정(dev_admin 등)에 쓸 비밀번호. 본인이 정하세요. 8자 이상.
DEV_PASSWORD=
